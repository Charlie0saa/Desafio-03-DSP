@model EquiposMVC.Models.EquipoViewModel

@{
    ViewData["Title"] = "Editar Equipo";
    var categorias = ViewBag.Categorias as IEnumerable<EquiposMVC.Models.CategoriaViewModel> ?? new List<EquiposMVC.Models.CategoriaViewModel>();
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Editar Equipo</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <!-- Se envía la versión de concurrencia optimista (RowVersion) -->
                    <input type="hidden" asp-for="RowVersion" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="CodigoInventario" class="form-label">Código de Inventario</label>
                        <input asp-for="CodigoInventario" class="form-control" />
                        <span asp-validation-for="CodigoInventario" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre del Equipo</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoriaId" class="form-label">Categoría</label>
                        <select asp-for="CategoriaId" class="form-select">
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.Id" selected="@(cat.Id == Model.CategoriaId ? "selected" : null)">@cat.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-warning fw-bold">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>