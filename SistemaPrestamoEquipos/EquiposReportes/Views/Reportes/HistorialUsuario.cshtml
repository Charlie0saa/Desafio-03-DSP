@model IEnumerable<EquiposReportes.ViewModels.HistorialUsuarioViewModel>

@{
    ViewData["Title"] = "Historial por Usuario";
}

<div class="container mt-4">
    <h2>Historial de Préstamos por Usuario</h2>
    <hr />

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="form-label">Buscar por Username</label>
            <input type="text" name="username" value="@ViewBag.Username" class="form-control" placeholder="Nombre de usuario..." />
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Usuario</th>
                <th>Equipo</th>
                <th>Fecha Préstamo</th>
                <th>Fecha Vencimiento</th>
                <th>Fecha Devolución</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Username</td>
                    <td>@item.EquipoNombre</td>
                    <td>@item.FechaPrestamo.ToString("yyyy-MM-dd")</td>
                    <td>@item.FechaVencimiento.ToString("yyyy-MM-dd")</td>
                    <td>@(item.FechaDevolucion.HasValue ? item.FechaDevolucion.Value.ToString("yyyy-MM-dd") : "Pendiente")</td>
                    <td>@item.Observaciones</td>
                </tr>
            }
        </tbody>
    </table>
</div>